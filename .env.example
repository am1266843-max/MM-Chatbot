# ==========================================
# MULTIMODAL AI CHATBOT ENVIRONMENT CONFIG
# ==========================================

# Application Environment
APP_ENV=development
APP_NAME="Multimodal AI Chatbot"
APP_DEBUG=true

# Server URLs
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
FRONTEND_PORT=8501
FRONTEND_URL=http://localhost:8501

# Database Configuration
# Leave blank or use sqlite:///./chatbot.db for lightweight local SQLite fallback.
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/chatbot_db
DATABASE_URL=sqlite:///./chatbot.db

# Storage Directories
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
MAX_UPLOAD_MB=15

# Default AI Provider & Model Configuration
# Available AI_PROVIDER options:
#   - "groq" (Fast, free-tier available with LLaMA 3.1 & LLaMA 3.2 Vision)
#   - "openai" (OpenAI GPT-4o, GPT-4o-mini)
#   - "huggingface" (Hugging Face Inference API / Serverless)
#   - "ollama" (Local Ollama at http://localhost:11434/v1)
#   - "mock" (Fallback test provider with zero API keys required)
AI_PROVIDER=mock
AI_MODEL=mock-model

# API Keys (Configure the ones you intend to use)
# Groq (Recommended for fast free-tier inference and vision)
GROQ_API_KEY=
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Hugging Face
HUGGINGFACE_API_KEY=
# Google Gemini (Optional)
GEMINI_API_KEY=

# RAG & Embeddings
# Options: "all-MiniLM-L6-v2" (fast, lightweight CPU), "paraphrase-multilingual-MiniLM-L12-v2"
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.35

# Web Search Provider
# Options: "duckduckgo" (Default, FREE, no API key needed), "tavily"
SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# Voice / Audio Services
# Text-to-Speech: "edge-tts" (FREE high-quality Microsoft Neural voices), "gtts" (Google TTS)
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AriaNeural

# Speech-to-Text: "groq-whisper" (if GROQ_API_KEY set), "openai-whisper" (if OPENAI_API_KEY set), "google-sr" (SpeechRecognition free)
STT_ENGINE=auto

